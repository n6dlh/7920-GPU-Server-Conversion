globals:
  - id: gpu1_last_speed
    type: float
    restore_value: no
    initial_value: '0.30'

  - id: gpu2_last_speed
    type: float
    restore_value: no
    initial_value: '0.30'

  - id: gpu3_last_speed
    type: float
    restore_value: no
    initial_value: '0.30'

interval:
  - interval: 5s
    then:
      - lambda: |-
          auto calc_speed = [](float temp, float min_pct, float target, float full_temp) -> float {
            if (isnan(temp)) {
              return min_pct / 100.0f;
            }

            if (full_temp <= target) {
              full_temp = target + 5.0f;
            }

            float min_speed = min_pct / 100.0f;

            if (temp <= target) {
              return min_speed;
            }

            if (temp >= full_temp) {
              return 1.0f;
            }

            float ratio = (temp - target) / (full_temp - target);
            return min_speed + ratio * (1.0f - min_speed);
          };

          float s1 = calc_speed(
            id(gpu1_temp).state,
            id(gpu1_min_speed).state,
            id(gpu1_target_temp).state,
            id(gpu1_full_temp).state
          );
          id(gpu1_last_speed) = s1;
          id(gpu1_pwm).set_level(s1);

          float s2 = calc_speed(
            id(gpu2_temp).state,
            id(gpu2_min_speed).state,
            id(gpu2_target_temp).state,
            id(gpu2_full_temp).state
          );
          id(gpu2_last_speed) = s2;
          id(gpu2_pwm).set_level(s2);

          float s3 = calc_speed(
            id(gpu3_temp).state,
            id(gpu3_min_speed).state,
            id(gpu3_target_temp).state,
            id(gpu3_full_temp).state
          );
          id(gpu3_last_speed) = s3;
          id(gpu3_pwm).set_level(s3);

